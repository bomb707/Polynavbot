# Application
NODE_ENV=development
LOG_LEVEL=info
TRADING_MODE=paper

# Infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polynavbot
REDIS_URL=redis://localhost:6379

# Polymarket API (public endpoints — no secrets)
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_GAMMA_API_URL=https://gamma-api.polymarket.com
POLY_DATA_API_URL=https://data-api.polymarket.com
POLY_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLY_WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLY_CHAIN_ID=137

# Strategy defaults (safe for paper mode)
MAX_DAILY_SPEND_USD=25
MAX_POSITION_SIZE_USD=2
MAX_MARKET_EXPOSURE_USD=10
MAX_THEME_EXPOSURE_USD=25
MIN_ENTRY_PRICE=0.005
MAX_ENTRY_PRICE=0.04
MIN_DAYS_TO_EXPIRY=30
MIN_LIQUIDITY_USD=1000
MAX_SPREAD=0.03
PAPER_STARTING_BALANCE_USD=500
PAPER_PASSIVE_FILL_ON_CROSS=true

# Risk limits
MAX_OPEN_EXPOSURE_USD=50
MAX_OPEN_POSITIONS=25
MAX_OPEN_ORDERS=10
MIN_ORDER_SIZE_USD=0.5
MAX_ORDER_SIZE_USD=2
MAX_OUTCOMES_PER_MARKET=2
ALLOW_BOTH_SIDES_SAME_MARKET=false
MAX_DAILY_LOSS_USD=10
DATA_STALE_SECONDS=300

# Exit rules
EXIT_NEAR_EXPIRY_HOURS=48
EXIT_TRAILING_STOP_PCT=0.6
EXIT_MIN_LIQUIDITY_USD=1000

# BullMQ jobs
JOB_CONCURRENCY=1
ENTRY_SIGNAL_DEDUP_MINUTES=10
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# WebSocket monitor
WS_ENABLED=false
WS_PING_INTERVAL_MS=10000
WS_RECONNECT_BASE_MS=1000
WS_RECONNECT_MAX_MS=30000
WS_SNAPSHOT_INTERVAL_SECONDS=60
WS_EXIT_DEBOUNCE_MS=2000
WS_SUBSCRIPTION_REFRESH_MS=60000
WS_REST_RECONCILE_INTERVAL_SECONDS=120

# Backtest simulation
BACKTEST_INTERVAL=1h
BACKTEST_SLIPPAGE_BPS=50
BACKTEST_FILL_PROBABILITY=0.7
BACKTEST_ASSUMED_SPREAD=0.02
BACKTEST_TOP_OF_BOOK_DEPTH_USD=25
BACKTEST_MIN_LIQUIDITY_FOR_EXIT=1000
BACKTEST_STARTING_CAPITAL_USD=500
BACKTEST_SEED=42

# Live trading credentials (required only when TRADING_MODE=live)
# PRIVATE_KEY=
# DEPOSIT_WALLET_ADDRESS=
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=
# POLY_SIGNATURE_TYPE=3
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_THE_RISKS
