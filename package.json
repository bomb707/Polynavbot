{
  "name": "polynavbot",
  "version": "0.1.0",
  "description": "Polymarket longshot trading bot",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "paper:run": "tsx src/index.ts paper:run",
    "entry:paper": "tsx src/index.ts entry:paper",
    "exit:paper": "tsx src/index.ts exit:paper",
    "positions:update": "tsx src/index.ts positions:update",
    "worker": "tsx src/index.ts worker",
    "scheduler": "tsx src/index.ts scheduler"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.53.2",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.4"
  }
}
